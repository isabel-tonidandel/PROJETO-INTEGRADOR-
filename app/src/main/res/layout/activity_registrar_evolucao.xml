<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar evolução"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registre suas medidas e acompanhe seu progresso"
            android:textSize="16sp"
            android:textColor="@color/texto_secundario"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtDataAvaliacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data da avaliação"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:background="@color/verde_claro"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Avaliação corporal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peso (kg)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <EditText
            android:id="@+id/edtPeso"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ex.: 65,5"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_hint"
            android:backgroundTint="@color/verde_principal"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Altura (cm)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal" />

        <EditText
            android:id="@+id/edtAltura"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ex.: 165"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_hint"
            android:backgroundTint="@color/verde_principal"
            android:padding="12dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSalvarEvolucao"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Salvar evolução"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao"
            android:backgroundTint="@color/fundo_botao" />

    </LinearLayout>

</ScrollView>