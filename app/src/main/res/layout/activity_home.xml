<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NutriMov"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saúde e Bem-Estar"
            android:textSize="18sp"
            android:textColor="@color/texto_secundario"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bem-vindo ao NutriMov!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAlimentacao"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Alimentação"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao"
            android:backgroundTint="@color/fundo_botao"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnExercicios"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Exercícios"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao"
            android:backgroundTint="@color/fundo_botao"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnTreinos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Treinos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao"
            android:backgroundTint="@color/fundo_botao"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Meu Perfil"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao"
            android:backgroundTint="@color/fundo_botao"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEvolucao"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Minha Evolução"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/texto_botao"
            android:backgroundTint="@color/fundo_botao" />

    </LinearLayout>

</ScrollView>